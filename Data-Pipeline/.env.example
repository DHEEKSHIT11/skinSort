# Copy to .env (which is git-ignored) and fill in. Never commit .env.

# Linux/VM: set to the output of `id -u` so files written by Airflow belong to you.
AIRFLOW_UID=50000

# Airflow web UI login
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=change-me
AIRFLOW_JWT_SECRET=change-me-to-a-long-random-string

# Alerts (leave empty to only log alerts)
SLACK_WEBHOOK_URL=
ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
